# App
APP_NAME=SmartCampus AI
ENV=development
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MySQL Database
DB_HOST=mysql
DB_PORT=3306
DB_USER=smartcampus
DB_PASSWORD=smartcampus_password
DB_NAME=smartcampus_ai
DATABASE_URL=mysql+pymysql://smartcampus:smartcampus_password@mysql:3306/smartcampus_ai

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# RAG
CHUNK_SIZE=500
CHUNK_OVERLAP=100
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=/app/vectordb
DOCUMENTS_PATH=/app/documents
SIMILARITY_THRESHOLD=0.35
TOP_K_RESULTS=5

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
